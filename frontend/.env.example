# Origine de l'API backend (SANS le suffixe /api).
# Laisser vide en developpement : le proxy Vite (vite.config.js) redirige
# les appels /api vers http://127.0.0.1:8000.
# Exemple en production : VITE_API_BASE_URL=https://api.sen-friperie.example
VITE_API_BASE_URL=

# Mode demonstration : donnees fictives locales, AUCUN appel reseau, aucune
# donnee envoyee a Supabase. Utile pour une demo hors ligne.
# Laisser vide/false pour utiliser le vrai backend.
# VITE_DEMO_MODE=true

