# Copiez ce fichier vers backend/.env et renseignez vos valeurs.
# Ne commitez JAMAIS le fichier .env reel (voir .gitignore).

# --- Securite ---
SECRET_KEY=changez-moi-par-une-cle-aleatoire-longue
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de donnees ---
# Laisser DATABASE_URL VIDE en developpement pour utiliser SQLite (aucun
# identifiant requis). Renseignez-le pour cibler PostgreSQL (Supabase).
#
# Connexion DIRECTE (session, port 5432) - reseaux autorisant IPv6 :
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:VOTRE_MOT_DE_PASSE@db.abcdefghijklmnop.supabase.co:5432/postgres
#
# Connexion via POOLER en mode transaction (port 6543) - recommandee pour
# Render / environnements a connexions ephemères :
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:VOTRE_MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
#
# Exemple FICTIF ci-dessus : remplacez par vos vraies valeurs Supabase.
DATABASE_URL=

# Duree de conservation des connexions (secondes). 0 = reconnexion a chaque requete.
DB_CONN_MAX_AGE=600
# Supabase impose SSL. Laisser true sauf raison particuliere.
DB_SSL_REQUIRE=true
# Delai de connexion (secondes).
DB_CONNECT_TIMEOUT=10
# Mettre a true UNIQUEMENT si vous utilisez le pooler en mode transaction (port 6543).
DB_DISABLE_PREPARED_STATEMENTS=false

# --- CORS (frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
